server {
    listen ${PORT};
    # PORT 若非 80，額外再聽 80，避免平台偵測到的 port 與實際 listen 不一致
    ${EXTRA_LISTEN}
    client_max_body_size 64M;

    # Zeabur 內網 DNS：由 entrypoint 從 /etc/resolv.conf 取得
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        # 用變數讓 nginx 在「每次請求」才解析後端，避免啟動時後端還沒就緒就 crash
        set $api_upstream ${API_URL};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;

        # Host 用後端自己的主機名（由 entrypoint 從 API_URL 取出），不是前端的網域。
        # API_URL 指向對外 https 網址時，邊緣路由要靠這個 header 才找得到服務。
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # API_URL 為 https 時，交握需要 SNI 與正確的憑證驗證主機名
        proxy_ssl_server_name on;
        proxy_ssl_name ${API_HOST};

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
