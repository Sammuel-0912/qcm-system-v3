# 複製成 .env 後修改：cp .env.example .env
# .env 含密碼，已列入 .gitignore，不要提交。

# PostgreSQL（只在 compose 內網使用，不對外開放）
POSTGRES_DB=qcm
POSTGRES_USER=qcm
# 必填：請改成夠長的隨機字串。只用英數字最保險（含 @ : / 需另做 URL 編碼）
POSTGRES_PASSWORD=change-me

# 對外網頁 port：瀏覽器開 http://<VM IP>:<WEB_PORT>
WEB_PORT=8080

# 時區：容器時間與 Level 3 點檢班別（日班 08–18、夜班 20–06）的廠區時區
TZ=Asia/Taipei
QCM_SITE_UTC_OFFSET=8

# 登入（帳號密碼＋JWT）
# 必填：JWT 簽章金鑰，請用長隨機字串，例：openssl rand -hex 32。改掉它所有人都要重新登入
QCM_JWT_SECRET=change-me-to-a-long-random-string
# 第一位最高權限管理者（只在資料庫還沒有最高權限管理者時建立；之後改密碼請從網頁改）
QCM_ADMIN_USERNAME=admin
# 至少 8 碼
QCM_ADMIN_PASSWORD=admin555
# 一次性：忘記管理者密碼時設為 1，啟動會把上面帳號的密碼重設為 QCM_ADMIN_PASSWORD。用完一定要刪掉
# QCM_ADMIN_RESET=1
