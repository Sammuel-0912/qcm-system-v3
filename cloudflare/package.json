{
  "name": "qcm-v3-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build:frontend": "npm --prefix ../frontend ci && npm --prefix ../frontend run build",
    "check": "tsc --noEmit && wrangler deploy --dry-run",
    "deploy": "npm run build:frontend && wrangler deploy",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.3"
  }
}
